# Runtime
NODE_ENV=development
PORT=4000
APP_NAME=CodePilot AI API
APP_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000

# Database (MySQL 8.4 LTS)
DATABASE_URL=mysql://codepilot:replace_with_local_password@127.0.0.1:3306/codepilot_ai

# Security & Session Management
SESSION_SECRET=replace_with_at_least_32_character_random_secret_key
SESSION_TTL_HOURS=12
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=900000

# Logging & Telemetry
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=codepilot-ai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# GitHub App Integration (use GITHUB_MODE=fixture for local/CI deterministic testing)
GITHUB_MODE=fixture
GITHUB_APP_ID=
GITHUB_APP_SLUG=codepilot-ai-sandbox
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret

# Asynchronous Processing (Amazon SQS / Local ElasticMQ + Private S3 Artifacts)
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://127.0.0.1:9324
SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/codepilot-analysis-jobs
SQS_DLQ_URL=http://127.0.0.1:9324/000000000000/codepilot-analysis-jobs-dlq
S3_ENDPOINT_URL=
S3_ARTIFACTS_BUCKET=
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000
WORKER_VISIBILITY_TIMEOUT_SEC=120

# AI Provider Infrastructure (mock requires zero external credentials)
AI_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_REQUEST_COST_USD=1.00
