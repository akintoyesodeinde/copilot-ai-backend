{
  "name": "codepilot-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CodePilot AI — Standalone Node.js and Next.js Headless REST API Backend",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "prisma generate && next build",
    "start": "next start --port 4000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --outputFile.junit=test-results/unit-junit.xml",
    "test:integration": "vitest run tests/integration --outputFile.junit=test-results/integration-junit.xml",
    "test:authz": "vitest run tests/authorization --outputFile.junit=test-results/authz-junit.xml"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "mariadb": "^3.5.4",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.6",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "effect": "^3.22.5"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
