  testGenerationJob TestGenerationJob     @relation(fields: [workspaceId, testGenerationJobId], references: [workspaceId, id], onDelete: Cascade, map: "generated_tests_ws_job_fkey")
  repository        Repository            @relation(fields: [workspaceId, repositoryId], references: [workspaceId, id], onDelete: Cascade, map: "generated_tests_ws_repo_fkey")
  approvedBy        User?                 @relation("GeneratedTestApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull, map: "generated_tests_approved_by_fkey")
  executionResults  TestExecutionResult[]

  @@unique([workspaceId, id], map: "generated_tests_ws_id_key")
  @@index([workspaceId, testGenerationJobId], map: "generated_tests_ws_job_idx")
  @@index([workspaceId, repositoryId, approvalStatus], map: "generated_tests_ws_repo_approval_idx")
  @@index([approvedByUserId], map: "generated_tests_approved_by_idx")
  @@map("generated_tests")
}

model TestExecutionResult {
  id               String   @id @default(uuid()) @db.Char(36)
  workspaceId      String   @map("workspace_id") @db.Char(36)
  generatedTestId  String   @map("generated_test_id") @db.Char(36)
  validationEngine String   @map("validation_engine") @db.VarChar(64)
  syntaxPassed     Boolean  @map("syntax_passed")
  diagnosticsJson  Json?    @map("diagnostics_json")
  sandboxExecuted  Boolean  @default(false) @map("sandbox_executed")
  summary          String   @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  generatedTest GeneratedTest @relation(fields: [workspaceId, generatedTestId], references: [workspaceId, id], onDelete: Cascade, map: "test_execution_results_ws_test_fkey")

  @@index([workspaceId, generatedTestId], map: "test_execution_results_ws_test_idx")
  @@map("test_execution_results")
}
